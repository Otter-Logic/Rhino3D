  <!-- ONNX Runtime's native onnxruntime.dll lands under runtimes/win-x64/native,
       where an application's deps.json would find it. A .gha is not an
       application: Grasshopper loads it into Rhino, whose probing knows nothing
       of that folder, and the P/Invoke then fails with a DllNotFoundException
       the first time Predict opens a model. .NET does probe the folder of the
       managed assembly making the call, so the natives are copied up beside it. -->
  <Target Name="CopyOnnxRuntimeNatives" AfterTargets="Build">
    <ItemGroup>
      <OnnxRuntimeNative Include="$(OutDir)runtimes\win-x64\native\*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(OnnxRuntimeNative)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

