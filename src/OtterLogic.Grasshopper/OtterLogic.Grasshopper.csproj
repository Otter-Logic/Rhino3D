      </ItemGroup>
    </When>
    <Otherwise>
      <ItemGroup>
        <PackageReference Include="OtterLogic.Fabrication" Version="[$(Version)]" />
      </ItemGroup>
    </Otherwise>
  </Choose>

  <!-- Structural Design: every multipurpose structural tool - the 6DOF
       Behaviour Classifier and the Structural Insight Engine. The clustering
       they run on lives one layer down in Unsupervised. -->
  <Choose>
    <When Condition="Exists('$(MSBuildThisFileDirectory)..\..\..\StructuralEngine\src\OtterLogic.StructuralEngine\OtterLogic.StructuralEngine.csproj')">
      <ItemGroup>
        <ProjectReference Include="..\..\..\StructuralEngine\src\OtterLogic.StructuralEngine\OtterLogic.StructuralEngine.csproj" />
      </ItemGroup>
    </When>
    <Otherwise>
      <ItemGroup>
        <PackageReference Include="OtterLogic.StructuralEngine" Version="[$(Version)]" />
      </ItemGroup>
    </Otherwise>
  </Choose>

  <Choose>
    <When Condition="Exists('$(MSBuildThisFileDirectory)..\..\..\Construction\src\OtterLogic.Construction\OtterLogic.Construction.csproj')">
