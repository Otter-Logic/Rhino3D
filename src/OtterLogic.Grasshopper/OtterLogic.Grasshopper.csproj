<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>OtterLogic.Grasshopper</RootNamespace>
    <AssemblyName>OtterLogic.Grasshopper</AssemblyName>

    <!-- A .gha is an ordinary .NET assembly with a different extension. -->
    <TargetExt>.gha</TargetExt>

    <UseWindowsForms>true</UseWindowsForms>
    <EnableDynamicLoading>true</EnableDynamicLoading>

    <!-- Same folder as the .rhp, so one build updates both front-ends. -->
    <OutputPath>$(DistDir)</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- The Grasshopper package pulls RhinoCommon in with it. -->
    <PackageReference Include="Grasshopper" Version="$(RhinoVersion)" ExcludeAssets="runtime" />
    <ProjectReference Include="..\OtterLogic.Core\OtterLogic.Core.csproj" />
    <ProjectReference Include="..\OtterLogic.StructuralForm\OtterLogic.StructuralForm.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- One set of masters in assets/icons, embedded into both front-ends.
         LogicalName is what EmbeddedIcons looks up, so it must match there. -->
    <EmbeddedResource Include="..\..\assets\icons\otterlogic.png" LogicalName="OtterLogic.Icons.otterlogic.png" />
    <EmbeddedResource Include="..\..\assets\icons\truss2d.png" LogicalName="OtterLogic.Icons.truss2d.png" />
    <Compile Include="..\Shared\EmbeddedIcons.cs" Link="Shared\EmbeddedIcons.cs" />
  </ItemGroup>

</Project>
