<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>OtterLogic.Grasshopper</RootNamespace>
    <AssemblyName>OtterLogic.Grasshopper</AssemblyName>

    <!-- A .gha is an ordinary .NET assembly with a different extension. -->
    <TargetExt>.gha</TargetExt>

    <UseWindowsForms>true</UseWindowsForms>
    <EnableDynamicLoading>true</EnableDynamicLoading>

    <!-- Same folder as the .rhp, so one build updates both front-ends. -->
    <OutputPath>$(DistDir)</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- The Grasshopper package pulls RhinoCommon in with it. -->
    <PackageReference Include="Grasshopper" Version="$(RhinoVersion)" ExcludeAssets="runtime" />
  </ItemGroup>

  <!-- A sibling checkout of Core wins; the published package is the
       fallback. Clone the repos side by side and the inner loop is unchanged;
       CI has no siblings, so it builds against the published package. -->
  <Choose>
    <When Condition="Exists('$(MSBuildThisFileDirectory)..\..\..\Core\src\OtterLogic.Core\OtterLogic.Core.csproj')">
      <ItemGroup>
        <ProjectReference Include="..\..\..\Core\src\OtterLogic.Core\OtterLogic.Core.csproj" />
      </ItemGroup>
    </When>
    <Otherwise>
      <ItemGroup>
        <PackageReference Include="OtterLogic.Core" Version="[$(Version)]" />
      </ItemGroup>
    </Otherwise>
  </Choose>

  <!-- Unsupervised: where the clustering components' algorithms live. A
       sibling checkout wins; the published package is the fallback. -->
  <Choose>
    <When Condition="Exists('$(MSBuildThisFileDirectory)..\..\..\Unsupervised\src\OtterLogic.Unsupervised\OtterLogic.Unsupervised.csproj')">
      <ItemGroup>
        <ProjectReference Include="..\..\..\Unsupervised\src\OtterLogic.Unsupervised\OtterLogic.Unsupervised.csproj" />
      </ItemGroup>
    </When>
    <Otherwise>
      <ItemGroup>
        <PackageReference Include="OtterLogic.Unsupervised" Version="[$(Version)]" />
      </ItemGroup>
    </Otherwise>
  </Choose>

  <!-- A sibling checkout of MachineLearning wins; the published package is the
       fallback. It is a layer rather than a domain - it sits above Core and
       below the toolkits, and a toolkit may reference it. -->
  <Choose>
    <When Condition="Exists('$(MSBuildThisFileDirectory)..\..\..\MachineLearning\src\OtterLogic.MachineLearning\OtterLogic.MachineLearning.csproj')">
      <ItemGroup>
        <ProjectReference Include="..\..\..\MachineLearning\src\OtterLogic.MachineLearning\OtterLogic.MachineLearning.csproj" />
      </ItemGroup>
    </When>
    <Otherwise>
      <ItemGroup>
        <PackageReference Include="OtterLogic.MachineLearning" Version="[$(Version)]" />
      </ItemGroup>
    </Otherwise>
  </Choose>

  <!-- A sibling checkout of Document wins; the published package is the
       fallback. -->
  <Choose>
    <When Condition="Exists('$(MSBuildThisFileDirectory)..\..\..\Document\src\OtterLogic.Document\OtterLogic.Document.csproj')">
      <ItemGroup>
        <ProjectReference Include="..\..\..\Document\src\OtterLogic.Document\OtterLogic.Document.csproj" />
      </ItemGroup>
    </When>
    <Otherwise>
      <ItemGroup>
        <PackageReference Include="OtterLogic.Document" Version="[$(Version)]" />
      </ItemGroup>
    </Otherwise>
  </Choose>

  <!-- Structural Design: tools that act on analysis results. The 6DOF
       Behaviour Classifier lives here; the clustering it runs on lives one
       layer down in Unsupervised. -->
  <Choose>
    <When Condition="Exists('$(MSBuildThisFileDirectory)..\..\..\StructuralDesign\src\OtterLogic.StructuralDesign\OtterLogic.StructuralDesign.csproj')">
      <ItemGroup>
        <ProjectReference Include="..\..\..\StructuralDesign\src\OtterLogic.StructuralDesign\OtterLogic.StructuralDesign.csproj" />
      </ItemGroup>
    </When>
    <Otherwise>
      <ItemGroup>
        <PackageReference Include="OtterLogic.StructuralDesign" Version="[$(Version)]" />
      </ItemGroup>
    </Otherwise>
  </Choose>

  <!-- A sibling checkout of StructuralForm wins; the published package is the
       fallback. Clone the repos side by side and the inner loop is unchanged;
       CI has no siblings, so it builds against the published package. -->
  <Choose>
    <When Condition="Exists('$(MSBuildThisFileDirectory)..\..\..\StructuralForm\src\OtterLogic.StructuralForm\OtterLogic.StructuralForm.csproj')">
      <ItemGroup>
        <ProjectReference Include="..\..\..\StructuralForm\src\OtterLogic.StructuralForm\OtterLogic.StructuralForm.csproj" />
      </ItemGroup>
    </When>
    <Otherwise>
      <ItemGroup>
        <PackageReference Include="OtterLogic.StructuralForm" Version="[$(Version)]" />
      </ItemGroup>
    </Otherwise>
  </Choose>


  <ItemGroup>
    <!-- One set of masters in assets/icons, embedded into both front-ends.
         LogicalName is what EmbeddedIcons looks up, so it must match there. -->
    <EmbeddedResource Include="..\..\assets\icons\otterlogic.png" LogicalName="OtterLogic.Icons.otterlogic.png" />
    <EmbeddedResource Include="..\..\assets\icons\flattruss.png" LogicalName="OtterLogic.Icons.flattruss.png" />
    <EmbeddedResource Include="..\..\assets\icons\TrussType.png" LogicalName="OtterLogic.Icons.trusstype.png" />
    <EmbeddedResource Include="..\..\assets\icons\layerpicker.png" LogicalName="OtterLogic.Icons.layerpicker.png" />
  </ItemGroup>

</Project>
