<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>OtterLogic.Rhino</RootNamespace>
    <AssemblyName>OtterLogic</AssemblyName>

    <!-- A .rhp is an ordinary .NET assembly with a different extension. -->
    <TargetExt>.rhp</TargetExt>

    <UseWindowsForms>true</UseWindowsForms>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>

    <!-- Both front-ends land in one folder next to OtterLogic.Core.dll, so a
         single build keeps Rhino and Grasshopper in sync. -->
    <OutputPath>$(DistDir)</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- WindowsForms stays enabled for System.Drawing, which the conduits and
         the command use, but its implicit usings are dropped so the names are
         never ambiguous. The files that want them import them explicitly. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- ExcludeAssets="runtime" stops RhinoCommon.dll being copied beside the
         plugin, which would clash with the copy Rhino has already loaded. -->
    <PackageReference Include="RhinoCommon" Version="$(RhinoVersion)" ExcludeAssets="runtime" />
  </ItemGroup>

  <!-- A sibling checkout of Core wins; the published package is the
       fallback. Clone the repos side by side and the inner loop is unchanged;
       CI has no siblings, so it builds against the published package. -->
  <Choose>
    <When Condition="Exists('$(MSBuildThisFileDirectory)..\..\..\Core\src\OtterLogic.Core\OtterLogic.Core.csproj')">
      <ItemGroup>
        <ProjectReference Include="..\..\..\Core\src\OtterLogic.Core\OtterLogic.Core.csproj" />
      </ItemGroup>
    </When>
    <Otherwise>
      <ItemGroup>
        <PackageReference Include="OtterLogic.Core" Version="[$(Version)]" />
      </ItemGroup>
    </Otherwise>
  </Choose>

  <!-- A sibling checkout of StructuralForm wins; the published package is the
       fallback. Clone the repos side by side and the inner loop is unchanged;
       CI has no siblings, so it builds against the published package. -->
  <Choose>
    <When Condition="Exists('$(MSBuildThisFileDirectory)..\..\..\StructuralForm\src\OtterLogic.StructuralForm\OtterLogic.StructuralForm.csproj')">
      <ItemGroup>
        <ProjectReference Include="..\..\..\StructuralForm\src\OtterLogic.StructuralForm\OtterLogic.StructuralForm.csproj" />
      </ItemGroup>
    </When>
    <Otherwise>
      <ItemGroup>
        <PackageReference Include="OtterLogic.StructuralForm" Version="[$(Version)]" />
      </ItemGroup>
    </Otherwise>
  </Choose>


  <ItemGroup>
    <!-- No embedded icons here: the toolbar carries its own as base64 inside
         the .rui. This one is a loose file in the package, because manifest.yml
         points at it for the Package Manager listing and that cannot read an
         embedded resource. -->
    <None Include="..\..\assets\icons\otterlogic.png" Link="otterlogic.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Must land beside the .rhp with a matching base name: that is how Rhino
         finds a plug-in toolbar. -->
    <None Include="UI\OtterLogic.rui" Link="OtterLogic.rui" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- F5 launches Rhino with the debugger attached. -->
  <ItemGroup>
    <None Update="Properties\launchSettings.json" CopyToOutputDirectory="Never" />
  </ItemGroup>

</Project>
