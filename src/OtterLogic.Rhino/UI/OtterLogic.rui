<?xml version="1.0" encoding="utf-8"?>
<!--
  OtterLogic toolbar.

  Rhino loads a .rui sitting beside the .rhp with a matching base name the first
  time the plug-in loads, then copies it into the user's own UI settings. From
  then on Rhino uses their copy, so edits here only reach a machine that has not
  seen the file before - bump major_version on the group item to push a change.

  Structure, mirroring Rhino's own default.rui:
    macros          - one entry per command, holding the script to run
    tool_bar_groups - the docked tab bar; each group_item is one tab
    tool_bars       - the buttons behind each tab, referencing macros by guid

  Buttons carry no bitmap_id, so Rhino renders their text. The bitmap_id values
  in the default file are GUIDs into Rhino's own icon library, which a third
  party cannot reference; custom icons go in the <bitmaps> section instead.
-->
<RhinoUI major_ver="5" minor_ver="0" guid="314953c7-93fd-4112-b048-671a7c3c8ce2">

  <!--
    Five display strings, each read somewhere different: text in Rhino's button
    editor, tooltip on hover, help_text in the status bar, button_text on the
    button face (only when the toolbar is set to show text), menu_text in
    menus. Only tooltip shows on hover, so it leads with the tool's name.
  -->
  <macros>
    <macro_item guid="4e53c0fe-9ee5-4a87-ad0c-4e397620ee93" bitmap_id="0b3809d9-6ce0-4f3f-b427-8d596b600b0d">
      <text>
        <locale_1033>Flat Truss</locale_1033>
      </text>
      <tooltip>
        <locale_1033>Flat Truss: bracing between two chords you drew</locale_1033>
      </tooltip>
      <help_text>
        <locale_1033>Generate a flat truss between a top and a bottom chord.</locale_1033>
      </help_text>
      <button_text>
        <locale_1033>Flat Truss</locale_1033>
      </button_text>
      <menu_text>
        <locale_1033>Flat Truss</locale_1033>
      </menu_text>
      <script>! _OtterFlatTruss</script>
    </macro_item>
    <macro_item guid="5fb6ec17-107a-4848-a0e0-c9e47ef78983" bitmap_id="ca9feb5c-ac6d-4e49-bd2d-6feddef591d8">
      <text>
        <locale_1033>Box Truss</locale_1033>
      </text>
      <tooltip>
        <locale_1033>Box Truss: a triangular or box truss on three or four chords you drew</locale_1033>
      </tooltip>
      <help_text>
        <locale_1033>Generate a 3D truss on one or two top chords and one or two bottom chords.</locale_1033>
      </help_text>
      <button_text>
        <locale_1033>Box Truss</locale_1033>
      </button_text>
      <menu_text>
        <locale_1033>Box Truss</locale_1033>
      </menu_text>
      <script>! _OtterBoxTruss</script>
    </macro_item>
    <macro_item guid="74f29ce7-a053-445c-ba3c-56c07480b5a2" bitmap_id="802df9c2-db82-4110-afb2-9feddf691a63">
      <text>
        <locale_1033>Beam Infill</locale_1033>
      </text>
      <tooltip>
        <locale_1033>Beam Infill: secondary members in every panel between the beams you select</locale_1033>
      </tooltip>
      <help_text>
        <locale_1033>Fill the panels a floor's primary beams enclose with evenly spaced secondary members.</locale_1033>
      </help_text>
      <button_text>
        <locale_1033>Beam Infill</locale_1033>
      </button_text>
      <menu_text>
        <locale_1033>Beam Infill</locale_1033>
      </menu_text>
      <script>! _OtterBeamInfill</script>
    </macro_item>
    <macro_item guid="893a2970-8a8e-49ef-ba57-c5c842aea6ac" bitmap_id="0cc53375-7cc6-4962-b887-962416f8f26c">
      <text>
        <locale_1033>Surface Grid</locale_1033>
      </text>
      <tooltip>
        <locale_1033>Surface Grid: a quad, triangulated or diagrid layout over a surface, or between the curves round an area</locale_1033>
      </tooltip>
      <help_text>
        <locale_1033>Lay straight members over a surface as a quad grid, a triangulated grid or a diagrid.</locale_1033>
      </help_text>
      <button_text>
        <locale_1033>Surface Grid</locale_1033>
      </button_text>
      <menu_text>
        <locale_1033>Surface Grid</locale_1033>
      </menu_text>
      <script>! _OtterSurfaceGrid</script>
    </macro_item>
    <macro_item guid="c367c488-3af8-41ee-9d49-b4f007d40abd" bitmap_id="f1a75988-e5a2-49cc-82aa-4a5f9a39641a">
      <text>
        <locale_1033>Space Truss</locale_1033>
      </text>
      <tooltip>
        <locale_1033>Space Truss: a double-layer space truss on a surface, or between the curves round an area</locale_1033>
      </tooltip>
      <help_text>
        <locale_1033>Build a space truss on a surface grid: a second layer a given depth under it, and a web between the two.</locale_1033>
      </help_text>
      <button_text>
        <locale_1033>Space Truss</locale_1033>
      </button_text>
      <menu_text>
        <locale_1033>Space Truss</locale_1033>
      </menu_text>
      <script>! _OtterSpaceTruss</script>
    </macro_item>
    <macro_item guid="fe95f098-e689-427a-9a7f-d4fcc0923a47" bitmap_id="b6413f0f-9305-420d-8723-7b7af16850d9">
      <text>
        <locale_1033>Grid Columns</locale_1033>
      </text>
      <tooltip>
        <locale_1033>Grid Columns: a column at every crossing of the gridlines you select, between two heights</locale_1033>
      </tooltip>
      <help_text>
        <locale_1033>Select gridlines, see where they cross in plan, give a base and a top height, and stand a column at every crossing.</locale_1033>
      </help_text>
      <button_text>
        <locale_1033>Grid Columns</locale_1033>
      </button_text>
      <menu_text>
        <locale_1033>Grid Columns</locale_1033>
      </menu_text>
      <script>! _OtterColumn</script>
    </macro_item>
    <macro_item guid="f84858b3-64d6-44a0-a3db-da4f9d7cdfae" bitmap_id="b1e4ff19-a180-4854-8032-db4ca1703ef7">
      <text>
        <locale_1033>Rectangular Grid</locale_1033>
      </text>
      <tooltip>
        <locale_1033>Rectangular Grid: gridlines both ways from typed bay spacings, with a node at every crossing</locale_1033>
      </tooltip>
      <help_text>
        <locale_1033>Pick an origin, type the bays each way (6000, or 3x6000, 8000), adjust the overhang and angle against a preview, and bake the gridlines and nodes.</locale_1033>
      </help_text>
      <button_text>
        <locale_1033>Rectangular Grid</locale_1033>
      </button_text>
      <menu_text>
        <locale_1033>Rectangular Grid</locale_1033>
      </menu_text>
      <script>! _OtterGrid</script>
    </macro_item>
    <macro_item guid="b904e14c-df53-49f4-8223-7c7e002cdf02" bitmap_id="d72bcfe7-ab57-46ec-9939-cf38ddc72446">
      <text>
        <locale_1033>Radial Grid</locale_1033>
      </text>
      <tooltip>
        <locale_1033>Radial Grid: rays and rings about a centre over any sweep, with a node wherever they meet</locale_1033>
      </tooltip>
      <help_text>
        <locale_1033>Pick a centre, type the ring spacings, give the sweep in degrees and the number of bays, adjust against a preview, and bake the rays, rings and nodes.</locale_1033>
      </help_text>
      <button_text>
        <locale_1033>Radial Grid</locale_1033>
      </button_text>
      <menu_text>
        <locale_1033>Radial Grid</locale_1033>
      </menu_text>
      <script>! _OtterRadialGrid</script>
    </macro_item>
    <macro_item guid="dd08337e-242a-4074-93ed-8cd25c4d821d" bitmap_id="b1b2ab78-edeb-455e-896f-5fb13b88d67d">
      <text>
        <locale_1033>Grid Beams</locale_1033>
      </text>
      <tooltip>
        <locale_1033>Grid Beams: a primary beam along every gridline between each pair of neighbouring columns on it, at a level or on a surface</locale_1033>
      </tooltip>
      <help_text>
        <locale_1033>Select the columns, then the gridlines, give a level or pick a surface, and run a beam between every two neighbouring columns on each gridline.</locale_1033>
      </help_text>
      <button_text>
        <locale_1033>Grid Beams</locale_1033>
      </button_text>
      <menu_text>
        <locale_1033>Grid Beams</locale_1033>
      </menu_text>
      <script>! _OtterBeam</script>
    </macro_item>
  </macros>

  <!--
    Icons. Rhino's own default.rui carries no bitmaps at all - every
    bitmap_id there indexes Rhino's internal icon library, which a third
    party cannot reference. Custom icons ride here instead: one horizontal
    strip per size, base64 PNG, with each bitmap_item naming the slot it
    occupies. Index 0 is Flat Truss, 1 is Box Truss, 2 is Beam Infill, 3 is Surface Grid,
    4 is Space Truss, 5 is Grid Columns, 6 is Rectangular Grid, 7 is Radial Grid,
    8 is Grid Beams.

    Regenerate with build/build-rui-icons.ps1 after changing assets/icons.
  -->
  <bitmaps>
    <small_bitmap item_width="16" item_height="16">
      <bitmap_item guid="0b3809d9-6ce0-4f3f-b427-8d596b600b0d" index="0" />
