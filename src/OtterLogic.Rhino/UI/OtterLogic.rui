<?xml version="1.0" encoding="utf-8"?>
<!--
  OtterLogic toolbar.

  Rhino loads a .rui sitting beside the .rhp with a matching base name the first
  time the plug-in loads, then copies it into the user's own UI settings. From
  then on Rhino uses their copy, so edits here only reach a machine that has not
  seen the file before - bump major_version on the group item to push a change.

  Structure, mirroring Rhino's own default.rui:
    macros          - one entry per command, holding the script to run
    tool_bar_groups - the docked tab bar; each group_item is one tab
    tool_bars       - the buttons behind each tab, referencing macros by guid

  Buttons carry no bitmap_id, so Rhino renders their text. The bitmap_id values
  in the default file are GUIDs into Rhino's own icon library, which a third
  party cannot reference; custom icons go in the <bitmaps> section instead.
-->
<RhinoUI major_ver="5" minor_ver="0" guid="314953c7-93fd-4112-b048-671a7c3c8ce2">

  <!--
    Five display strings, each read somewhere different: text in Rhino's button
    editor, tooltip on hover, help_text in the status bar, button_text on the
    button face (only when the toolbar is set to show text), menu_text in
    menus. Only tooltip shows on hover, so it leads with the tool's name.
  -->
  <macros>
    <macro_item guid="4e53c0fe-9ee5-4a87-ad0c-4e397620ee93" bitmap_id="0b3809d9-6ce0-4f3f-b427-8d596b600b0d">
      <text>
        <locale_1033>Flat Truss</locale_1033>
      </text>
      <tooltip>
        <locale_1033>Flat Truss: bracing between two chords you drew</locale_1033>
      </tooltip>
      <help_text>
        <locale_1033>Generate a flat truss between a top and a bottom chord.</locale_1033>
      </help_text>
      <button_text>
        <locale_1033>Flat Truss</locale_1033>
      </button_text>
      <menu_text>
        <locale_1033>Flat Truss</locale_1033>
      </menu_text>
      <script>! _OtterFlatTruss</script>
    </macro_item>
  </macros>

  <!--
    Icons. Rhino's own default.rui carries no bitmaps at all - every
    bitmap_id there indexes Rhino's internal icon library, which a third
    party cannot reference. Custom icons ride here instead: one horizontal
    strip per size, base64 PNG, with each bitmap_item naming the slot it
    occupies. Index 0 is Flat Truss.

    Regenerate with build/build-rui-icons.ps1 after changing assets/icons.
  -->
  <bitmaps>
    <small_bitmap item_width="16" item_height="16">
      <bitmap_item guid="0b3809d9-6ce0-4f3f-b427-8d596b600b0d" index="0" />
      <bitmap></bitmap>
    </small_bitmap>
    <normal_bitmap item_width="24" item_height="24">
      <bitmap_item guid="0b3809d9-6ce0-4f3f-b427-8d596b600b0d" index="0" />
      <bitmap></bitmap>
    </normal_bitmap>
    <large_bitmap item_width="32" item_height="32">
      <bitmap_item guid="0b3809d9-6ce0-4f3f-b427-8d596b600b0d" index="0" />
      <bitmap></bitmap>
    </large_bitmap>
  </bitmaps>

  <tool_bar_groups>
    <tool_bar_group guid="6f927ce8-4f2b-46c7-a6c4-5d5bff26287c"
                    dock_bar_guid64="e7203192-4781-40fe-a743-b1afed0761f5"
                    active_tool_bar_group="cb09938f-eb86-48db-9d2b-2166837dcc16"
                    single_file="False"
                    hide_single_tab="False">
      <text>
        <locale_1033>OtterLogic Toolbar Group</locale_1033>
      </text>
      <tool_bar_group_item guid="cb09938f-eb86-48db-9d2b-2166837dcc16" major_version="2" minor_version="0">
        <text>
          <locale_1033>OtterLogic</locale_1033>
        </text>
        <tool_bar_id>59b291d0-516b-42e2-ab6e-a8318c442909</tool_bar_id>
      </tool_bar_group_item>

      <!-- Without this the group loads but its bar is never shown. Docked at the
           top as its own row rather than sharing Rhino's dock bar: pointing
           dock_bar_guid64 at Rhino's own bar does not add a tab to it, it takes
           the bar over and hides Standard, CPlanes and the rest. -->
      <dock_bar_info dock_bar="False" docking="True" horz="False" visible="True"
                     floating="True" dock_location="top" float_point="200,200" float_size="240,64" />
    </tool_bar_group>
  </tool_bar_groups>

  <tool_bars>
    <tool_bar guid="59b291d0-516b-42e2-ab6e-a8318c442909" platforms="Win">
      <text>
        <locale_1033>OtterLogic</locale_1033>
      </text>
      <tool_bar_item guid="560c5049-8bd5-450a-a2e3-c7a3b1b72f0e">
        <text>
          <locale_1033>Flat Truss</locale_1033>
        </text>
        <left_macro_id>4e53c0fe-9ee5-4a87-ad0c-4e397620ee93</left_macro_id>
      </tool_bar_item>
    </tool_bar>
  </tool_bars>

</RhinoUI>

